# Environment Configuration Template
# Copy this file to .env and configure local settings as required.
# The .env file is excluded by .gitignore and will not be pushed to GitHub.

# Application Server
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Execution Settings
RANDOM_SEED=42
LOG_LEVEL=INFO

# Optional External Integration Placeholders
SIEM_WEBHOOK_URL=
ALERT_NOTIFICATION_EMAIL=
